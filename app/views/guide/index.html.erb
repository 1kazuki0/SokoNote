<% content_for :back_path, setting_path %>
<% content_for :title do %>
  このアプリの使い方
<% end %>


<div class="text-center py-5 px-4 mb-6">
  <p class="text-2xl text-primary font-bold">
    ようこそ
  </p>
  <div class="flex items-center justify-center gap-1 mb-3">
    <%= image_tag "lp/logo.png", alt: "SokoNote", class: "h-18" %>
    <span class="text-2xl text-primary font-bold mt-10">へ</span>
  </div>
  <div class="w-6 h-0.5 bg-primary-light mx-auto mb-3"></div>
  <p class="text-dark-gray leading-relaxed">
    「もっと安く買えたかも」をなくす、<br>底値×単価記録アプリです。
  </p>
</div>
<div class="space-y-4">
  <!-- 記録する -->
  <details class="group bg-white border border-light-gray rounded-xl">
    <summary class="flex items-center justify-between cursor-pointer p-5 list-none gap-3">
      <div class="flex items-center gap-3 flex-1">
        <span class="w-7 h-7 bg-primary text-white rounded-full flex items-center justify-center font-bold shrink-0">1</span>
        <p class="font-bold text-black text-xl">記録する</p>
      </div>
      <span class="material-symbols-outlined text-middle-gray group-open:rotate-180 transition-transform shrink-0">
        expand_more
      </span>
    </summary>
    <!-- 開いた時だけ表示される部分 -->
    <div class="px-5 pb-5 text-dark-gray">
      <p>
        + ボタンをタップし、商品名・内容量・単位・価格・税を入力するだけで最短かつ簡単に登録することができます。
      </p>
      <%= image_tag "guide/item_registration.png", alt: "商品登録画面", class: "w-full mx-auto max-w-xs rounded-lg border border-light-gray" %>
    </div>
        <div class="px-5 pb-5 text-dark-gray">
      <p>
        登録後、より詳細を入力したい場合は、「詳細情報を追加する」よりさらに細いか内容を保存することができます。
      </p>
      <%= image_tag "guide/purchase_edit.png", alt: "商品登録画面", class: "w-full mx-auto max-w-xs rounded-lg border border-light-gray" %>
    </div>
  </details>
  <!-- Q2 -->
  <details class="group bg-white border border-light-gray rounded-xl">
    <summary class="flex items-center justify-between cursor-pointer p-5 list-none gap-3">
      <div class="flex items-center gap-3 flex-1">
        <span class="w-7 h-7 bg-primary text-white rounded-full flex items-center justify-center font-bold shrink-0">2</span>
        <p class="font-bold text-black text-xl">比較する</p>
      </div>
      <span class="material-symbols-outlined text-middle-gray group-open:rotate-180 transition-transform shrink-0">
        expand_more
      </span>
    </summary>
    <!-- 開いた時だけ表示される部分 -->
    <div class="px-5 pb-5 text-dark-gray">
      <p>
        2件以上登録すると、その商品の購入履歴からどちらが安いか一目見て判断することができます。
      </p>
      <%= image_tag "guide/purchases_index.png", alt: "商品登録画面", class: "w-full mx-auto max-w-xs rounded-lg border border-light-gray" %>
    </div>
    <div class="px-5 pb-5 text-dark-gray">
      <p>
        また、購入履歴画面の一番上にはその商品の中で一番最安値が表示されます。
      </p>
      <%= image_tag "guide/lowest_purchase.png", alt: "商品登録画面", class: "w-full mx-auto max-w-xs rounded-lg border border-light-gray" %>
    </div>
  </details>

  <!-- Q3 -->
  <details class="group bg-white border border-light-gray rounded-xl">
    <summary class="flex items-center justify-between cursor-pointer p-5 list-none gap-3">
      <div class="flex items-center gap-3 flex-1">
        <span class="w-7 h-7 bg-primary text-white rounded-full flex items-center justify-center font-bold shrink-0">3</span>
        <p class="font-bold text-black text-xl">登録なしでも比較できる</p>
      </div>
      <span class="material-symbols-outlined text-middle-gray group-open:rotate-180 transition-transform shrink-0">
        expand_more
      </span>
    </summary>
    <!-- 開いた時だけ表示される部分 -->
    <div class="px-5 pb-5 text-dark-gray">
      <p>
        登録しなくても、比較画面で価格・内容量・（パック数）・税を2つ入力するだけで即時にどちらが安いか判断できます
      </p>
      <%= image_tag "guide/comparison.png", alt: "商品登録画面", class: "w-full mx-auto max-w-xs rounded-lg border border-light-gray" %>
    </div>
  </details>
</div>

<div class="mt-8 space-y-4">
  <%= link_to new_item_registration_path, class: "card bg-accent text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
    <span class="text-xl tracking-widest">さっそく登録してみる</span>
    <span class="material-symbols-outlined">add_2</span>
  <% end %>
  <div class="flex items-center gap-4 my-5 mx-2">
    <hr class="flex-1 border-dark-gray">
    <span class="text-dark-gray">または</span>
    <hr class="flex-1 border-dark-gray">
  </div>
  <%= link_to comparison_path, class: "card bg-primary text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
    <span class="text-xl tracking-widest">登録なしで比較してみる</span>
    <span class="material-symbols-outlined">balance</span>
  <% end %>
</div>
