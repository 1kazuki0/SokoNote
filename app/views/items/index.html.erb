<!-- 商品一覧画面 -->
<!-- タイトル表示 -->
<% content_for :title do %>
  商品一覧
<% end %>

<!-- 1件以上の商品が登録されている場合 -->
<% if @has_any_items %>
  <!-- 検索フォーム -->
  <div class="mb-4">
    <%= search_form_for @q do |f| %>
      <div class="form flex">
        <span class="material-symbols-outlined text-middle-gray">search</span>
        <%= f.search_field :name_cont, placeholder: "商品を検索", class: "flex-auto outline-none pl-2 text-black bg-transparent placeholder-gray" %>
      </div>
    <% end %>
  </div>
  <!-- カテゴリーの選択絞り込み -->
  <div class="mb-4 flex gap-2 overflow-auto pb-1" style="scrollbar-width: thin;">
    <%= link_to "全て", items_path, class: "flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-bold whitespace-nowrap #{params.dig(:q, :category_id_eq).blank? && params.dig(:q, :category_id_null) != "1" ? 'bg-primary text-white' : 'bg-white text-middle-gray border border-light-gray'}" %>

    <!-- カテゴリーごとのチップ -->
    <% @categories.each do |category| %>
      <%= link_to category.name,
          items_path(q: { category_id_eq: category.id }),
          class: "flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-bold whitespace-nowrap #{params.dig(:q, :category_id_eq).to_s == category.id.to_s ? 'bg-primary text-white' : 'bg-white text-middle-gray border border-light-gray'}" %>
    <% end %>

    <!-- 「未登録」チップ -->
    <%= link_to "未登録",
        items_path(q: { category_id_null: "1" }),
        class: "flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-bold whitespace-nowrap #{params.dig(:q, :category_id_null) == "1" ? 'bg-primary text-white' : 'bg-white text-middle-gray border border-light-gray'}" %>
  </div>
    
  <!-- 検索した結果、商品がない場合 -->
  <% if @items.empty? %>
    <div class="flex flex-col items-center text-center py-12">
      <span class="material-symbols-outlined mb-12 text-dark-gray" style="font-size: 80px;">search_off</span>
      <h1 class="text-3xl font-bold text-black mb-4">
        検索した結果、見つかりませんでした
      </h1>
      <p class="text-dark-gray mb-8">
        この商品はまだ登録されていない可能性があります
      </p>

      <!-- 商品登録遷移ボタン -->
      <div class="w-full px-6 mb-8">
        <%= link_to new_item_registration_path, class: "card bg-primary text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
          <span class="text-xl tracking-widest">商品を登録する</span>
          <span class="material-symbols-outlined">add_2</span>
        <% end %>
      </div>

      <%= link_to "検索条件をリセット", items_path, class: "tracking-widest text-xl link text-primary font-bold" %>
    </div>

  <!-- 検索した結果、商品がある場合 -->
  <% else %>
    <div class="space-y-3">
      <% @items.each do |item| %>
        <% cheapest = item.purchases.min_by { |p| p.unit_price } %>
        <%= link_to item_purchases_path(item), class: "card bg-white rounded-2xl overflow-hidden border border-light-gray flex" do %>

          <!-- 左ボーダー：購入履歴があれば緑、なければグレー -->
          <div class="w-1.5 flex-shrink-0 <%= cheapest ? 'bg-primary' : 'bg-light-gray' %>"></div>

          <!-- カードの中身 -->
          <div class="flex-1 p-4">

            <!-- 商品名 + 「最安時の値段」タグ -->
            <div class="flex items-center justify-between">
              <h2 class="text-2xl font-bold text-black">
                <%= item.name %>
              </h2>
              <% if cheapest %>
                <span class="bg-light-gray/40 text-dark-gray text-xs px-2 py-0.5 rounded-full whitespace-nowrap">最安時の値段</span>
              <% end %>
            </div>

            <!-- 仕切り線 -->
            <hr class="my-2 border-t border-light-gray">

            <!--2列に分割 -->
            <div class="flex items-end justify-between">

              <% if cheapest %>

                <!-- 左側：店名・内容量・単価 -->
                <div class="flex-1">
                  <% if cheapest.store.present? %>
                    <div class="flex items-center gap-1 mb-1">
                      <span class="material-symbols-outlined text-primary" style="font-size: 16px;">storefront</span>
                      <span class="text-sm font-bold text-primary"><%= cheapest.store.name %></span>
                    </div>
                  <% else %>
                    <div class="flex items-center gap-1 mb-1">
                      <span class="text-sm text-middle-gray">店舗未登録</span>
                    </div>
                  <% end %>
                  <p class="text-sm text-black mb-1">
                    <% if cheapest.pack_unit.present? %>
                      <%= cheapest.content_quantity %><%= cheapest.content_unit.name %> × <%= cheapest.pack_quantity %><%= cheapest.pack_unit.name %>
                    <% else %>
                      <%= cheapest.content_quantity %><%= cheapest.content_unit.name %>
                    <% end %>
                  </p>
                  <p class="text-xs text-middle-gray">
                    (1<%= cheapest.content_unit.name %>あたり
                    <span class="text-primary font-bold text-sm"><%= number_with_delimiter(cheapest.unit_price) %>円</span>)
                  </p>
                </div>

                <!-- 右側：値段＋税 -->
                <div class="flex flex-col items-end ml-3 mb-2">
                  <p class="pb-1">
                    <span class="text-2xl font-bold text-black"><%= number_with_delimiter(cheapest.price) %></span>
                    <span class="text-xs text-black">円</span>
                  </p>
                  <p class="text-xs text-middle-gray">
                    (<%= case cheapest.tax_rate
                        when 0 then "税抜"
                        when 8 then "税込8%"
                        when 10 then "税込10%"
                        else "税区分未設定"
                        end %>)
                  </p>
                </div>
              <% else %>
                <div>
                  <p class="text-lg text-middle-gray mt-1">未登録</p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
      <!-- 商品登録遷移ボタン -->
      <div class="fixed bottom-28 left-0 right-0 mx-auto max-w-xl px-6 flex justify-end z-25">
        <%= link_to new_item_registration_path, class: "card bg-accent text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
          <span class="text-lg">商品登録</span>
          <span class="material-symbols-outlined">add_2</span>
        <% end %>
      </div>
    </div>
  <% end %>

<!-- 商品登録が0件の場合 -->
<% else %>
  <div class="flex flex-col items-center text-center py-8">
    <h1 class="text-3xl font-bold text-black mb-4">
      商品を登録しましょう
    </h1>
    <div class="mb-4 flex h-32 w-32 items-center justify-center rounded-full bg-light-gray">
      <span class="material-symbols-outlined text-dark-gray" style="font-size: 80px;">add_shopping_cart</span>
    </div>
    <p class="text-dark-gray mb-8">
      よく買う商品の価格を記録して、<br>
      賢く節約を始めましょう
    </p>

    <!-- 商品登録遷移ボタン -->
    <div class="w-full px-6 mb-8">
      <%= link_to new_item_registration_path, class: "card bg-primary text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
        <span class="text-xl tracking-widest">商品を登録する</span>
        <span class="material-symbols-outlined">add_2</span>
      <% end %>
    </div>

    <!-- 使い方説明リンク -->
    <%= link_to "使い方を見る", "#", class: "tracking-widest text-xl link text-primary font-bold" %>
  </div>
<% end %>
