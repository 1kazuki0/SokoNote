<!-- 購入履歴一覧画面 -->

<!-- 戻るボタン -->
<% content_for :back_path, items_path %>

<!-- タイトル表示 -->
<% content_for :title do %>
  <%= "#{@item.name} 購入履歴" %>
<% end %>

<!-- 商品に対して購入履歴が1件以上登録されている場合 -->
<% if @has_any_purchases %>
  <!-- 商品名・カテゴリ名の表示（カテゴリ名はnilの場合表示しない） -->
  <div class="flex items-center gap-2 mb-2">
    <h1 class="text-xl font-bold text-black"><%= @item.name %></h1>
    <% if @item.category.present? %>
      <span class="text-xs font-bold text-primary bg-primary/20 rounded-full px-2 py-0.5 "><%= @item.category.name %></span>
    <% end %>
  </div>

  <!-- 最安値単価表示 -->
  <% if @lowest_purchase %>
    <div class="bg-white border-2 border-accent rounded-2xl overflow-hidden mb-4">
      <div class="h-1 w-full bg-accent"></div>
      <div class="pb-2">
        
        <!-- 上部: バッジ + 記録日 -->
        <div class="flex justify-between items-center px-2 bg-accent pb-1">
          <span class="text-white text-xs font-bold px-2 py-0.5 rounded-full inline-flex items-center gap-1">
            <span class="material-symbols-outlined" style="font-size: 20px;">trending_down</span>
            現在最安値
          </span>
          <span class="text-xs text-white">
            <%= @lowest_purchase.purchased_on.strftime("%Y-%m-%d") %>
          </span>
        </div>

        <!-- 中段: 左に単価 / 右に内容量・金額 (中央仕切り線) -->
        <div class="grid grid-cols-2 p-2">

          <!-- 左: 単価 -->
          <div class="flex flex-col items-center justify-center border-r border-light-gray px-5 py-5">
            <span class="text-sm text-dark-gray mb-1">1<%= @lowest_purchase.content_unit.name %>あたり</span>
            <p class="leading-none">
              <span class="text-3xl md:text-5xl font-bold text-accent"><%= @lowest_purchase.unit_price %></span>
              <span class="text-lg text-accent ml-0.5">円</span>
            </p>
          </div>

          <!-- 右: 内容量 / 金額 (横仕切り線で2分割) -->
          <div class="flex flex-col justify-center pl-2 gap-2">
            <!-- 内容量 -->
            <div class="flex items-center gap-2 md:ml-2">
              <span class="material-symbols-outlined text-dark-gray" style="font-size: 20px;">package_2</span>
              <span class="text-black">
                <% if @lowest_purchase.pack_unit.present? %>
                  <%= @lowest_purchase.content_quantity %><%= @lowest_purchase.content_unit.name %> × <%= @lowest_purchase.pack_quantity %><%= @lowest_purchase.pack_unit.name %>
                <% else %>
                  <%= @lowest_purchase.content_quantity %><%= @lowest_purchase.content_unit.name %>
                <% end %>
              </span>
            </div>

            <hr class="border-t border-light-gray">

            <!-- 金額 + 税 -->
            <div class="flex items-center gap-2 md:ml-2">
              <span class="material-symbols-outlined text-dark-gray" style="font-size: 20px;">paid</span>
              <span class="text-lg font-bold text-black">¥<%= number_with_delimiter(@lowest_purchase.price) %></span>
              <span class="text-xs text-middle-gray">
                (<%= case @lowest_purchase.tax_rate
                    when 0 then "税抜"
                    when 8 then "税込8%"
                    when 10 then "税込10%"
                    end %>)
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- 下部: 店舗・ブランド (背景色付き) -->
      <div class="bg-accent/10 grid grid-cols-2 px-4 py-3">
        <!-- 店舗 -->
        <div class="flex items-center justify-center gap-2 border-r border-accent/30 pr-3">
          <span class="material-symbols-outlined text-dark-gray" style="font-size: 20px;" >storefront</span>
          <span class="text-sm text-black">
            <%= @lowest_purchase.store&.name || "—" %>
          </span>
        </div>
        
        <!-- ブランド -->
        <div class="flex items-center justify-center gap-2 pl-3">
          <span class="material-symbols-outlined text-dark-gray" style="font-size: 20px;">sell</span>
          <span class="text-sm text-black">
            <%= @lowest_purchase.brand&.presence || "—" %>
          </span>
        </div>
      </div>
      <div class="flex px-6 py-4 border-t border-light-gray items-center justify-center">
        <%= link_to comparison_path(purchase_id: @lowest_purchase.id),
            class: "inline-flex items-center gap-1 text-accent font-bold tracking-widest" do %>
          <span class="material-symbols-outlined" style="font-size: 20px;">balance</span>
          <span class="text-lg underline underline-offset-4">この商品で比較する</span>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="flex justify-between items-center mb-5">
    <h2 class="text-xl font-bold text-dark-gray">購入履歴</h2>
    <div class="flex gap-4 text-xl text-dark-gray">
      <span class="underline underline-offset-4"><%= sort_link(@q, :unit_price, "単価") %></span>
      <span class="underline underline-offset-4"><%= sort_link(@q, :purchased_on, "購入日")%></span>
    </div>
  </div>
  <div class="mb-4">
    <%= search_form_for @q, url: item_purchases_path(@item) do |f| %>
      <div class="form flex">
        <span class="material-symbols-outlined text-middle-gray">search</span>
        <%= f.search_field :store_name_cont, placeholder: "店舗名で絞り込み", list: "stores_list", class: "flex-auto outline-none pl-2 text-black bg-transparent placeholder-gray" %>
        <datalist id="stores_list">
          <% @stores.each do |store| %>
            <option value="<%= store.name %>">
          <% end %>
        </datalist>
      </div>
    <% end %>
  </div>
  
  <!-- 検索した結果、登録している店舗がない場合 -->
  <% if @purchases.empty? %>
    <div class="flex flex-col items-center text-center py-12">
      <span class="material-symbols-outlined mb-12 text-dark-gray" style="font-size: 80px;">search_off</span>
      <h1 class="text-3xl font-bold text-black mb-4">
        検索した結果、見つかりませんでした
      </h1>
      <p class="text-dark-gray mb-8">
        この店舗はまだ登録されていない可能性があります
      </p>

      <!-- 商品登録遷移ボタン -->
      <div class="w-full px-6 mb-8">
        <%= link_to new_item_registration_path, class: "card bg-primary text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
          <span class="text-xl tracking-widest">商品を登録する</span>
          <span class="material-symbols-outlined">add_2</span>
        <% end %>
      </div>

      <%= link_to "検索条件をリセット", item_purchases_path(@item), class: "tracking-widest text-xl link text-primary font-bold" %>
    </div>

  <!-- 検索した結果、登録している店舗がある場合 -->
  <% else %>
    <div class="space-y-2">
      <% @purchases.each do |purchase| %>
        <% is_lowest = purchase.id == @lowest_purchase&.id %>
        <div class="swipe-card <%= is_lowest ? 'border border-accent' : 'border border-light-gray' %>" data-controller="swipe" data-action="touchstart->swipe#touchstart touchend->swipe#touchend touchstart@document->swipe#outsideClick">

          <!-- 左側の緑ボーダー線の固定 -->
          <div class="absolute left-0 top-0 bottom-0 w-1.5 z-30 <%= is_lowest ? 'bg-accent' : 'bg-primary' %> rounded-l-2xl"></div>

          <!-- テキスト部分の固定 -->
          <div class="absolute left-3 top-0 bottom-0 right-10 z-10 py-3 px-3">
            <div class="flex h-full flex-col justify-between">

              <!-- 1段目：購入日 -->
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-dark-gray" style="font-size: 18px;">
                  calendar_month
                </span>

                <span class="text-xs text-middle-gray">
                  <%= purchase.purchased_on.strftime("%Y-%m-%d") %>
                </span>
              </div>

              <!-- 2段目：店舗名・ブランド -->
              <div class="flex items-center flex-wrap gap-3">

                <% if purchase.store.present? %>
                  <span class="<%= is_lowest ? 'bg-accent/10 text-accent' : 'bg-primary/10 text-primary' %> rounded-full px-3 py-0.5 text-xs font-bold">
                    <%= purchase.store.name %>
                  </span>
                <% end %>

                <% if purchase.brand.present? %>
                  <div class="flex items-center gap-1 text-xs text-black">
                    <span class="material-symbols-outlined text-dark-gray" style="font-size: 16px;">
                      sell
                    </span>

                    <span><%= purchase.brand %></span>
                  </div>
                <% end %>

              </div>

              <!-- 3段目：内容量 -->
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-dark-gray" style="font-size: 18px;">
                  package_2
                </span>

                <span class="text-sm text-black">
                  <% if purchase.pack_unit.present? %>
                    <%= purchase.content_quantity %><%= purchase.content_unit.name %> ×
                    <%= purchase.pack_quantity %><%= purchase.pack_unit.name %>
                  <% elsif purchase.pack_quantity > 1 %>
                    <%= purchase.content_quantity %><%= purchase.content_unit.name %> ×
                    <%= purchase.pack_quantity %>
                  <% else %>
                    <%= purchase.content_quantity %><%= purchase.content_unit.name %>
                  <% end %>
                </span>
              </div>

              <!-- 4段目：購入料金 -->
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-dark-gray" style="font-size: 18px;">
                  paid
                </span>

                <span class="text-lg font-bold text-black">
                  ¥<%= number_with_delimiter(purchase.price) %>
                </span>

                <span class="text-xs text-middle-gray">
                  (<%= case purchase.tax_rate
                      when 0 then "税抜"
                      when 8 then "税込8%"
                      when 10 then "税込10%"
                      else "税区分未設定"
                      end %>)
                </span>
              </div>

              <!-- 5段目：単価 -->
              <div class="<%= is_lowest ? 'bg-accent/10' : 'bg-primary/10' %> -mr-15 -ml-6 -mb-3 px-8 py-2 rounded-br-2xl">
                <span class="text-2xl font-bold <%= is_lowest ? 'text-accent' : 'text-primary' %>">
                  <%= purchase.unit_price %>
                </span>

                <span class="text-xs <%= is_lowest ? 'text-accent' : 'text-middle-gray' %>">
                  円/<%= purchase.content_unit.name %>
                </span>
              </div>

            </div>
          </div>
          <!-- swipe-inner：アイコンのみ・スライドする層 -->
          <div class="swipe-inner rounded-2xl" style="min-height: 11rem;" data-swipe-target="inner">
            <span class="material-symbols-outlined text-light-gray text-sm">keyboard_double_arrow_right</span>
          </div>

          <!-- スライドした時に表示される層 -->
          <div class="swipe-actions" data-swipe-target="actions" style="transform: translateX(100%);">
            <%= link_to "編集", edit_item_purchase_path(@item, purchase), data: { action: "touchend->swipe#stopPropagation" }, class: "flex items-center justify-center w-16 bg-blue-400 text-white text-sm font-medium self-stretch" %>
            <%= link_to "削除", item_purchase_path(@item, purchase), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？", action: "touchend->swipe#stopPropagation" }, class: "flex items-center justify-center w-16 bg-error text-white text-sm font-medium border-none cursor-pointer h-full" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

<!-- 商品に対して購入履歴が0件の場合 -->
<% else %>
  <div class="flex flex-col items-center text-center py-8">
    <h1 class="text-3xl font-bold text-black mb-2">
      購入履歴がありません
    </h1>
    <p class="text-black text-xl mb-4">
      商品名：<%= @item.name %>
    </p>
    <div class="mb-4 flex h-32 w-32 items-center justify-center rounded-full bg-light-gray">
      <span class="material-symbols-outlined text-dark-gray" style="font-size: 80px;">receipt_long_off</span>
    </div>
    <p class="text-dark-gray mb-8">
      購入履歴を登録するか、<br>
      不要であれば商品ごと削除できます
    </p>
    
    <!-- 商品登録・商品削除遷移ボタン -->
    <div class="w-full px-6 space-y-3">
      <%= link_to new_item_registration_path, class: "card bg-primary text-white px-6 py-4 rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
        <span class="text-xl tracking-widest">購入履歴を登録する</span>
        <span class="material-symbols-outlined">add_2</span>
      <% end %>
      <%= button_to item_path(@item), method: :delete, form: { data: { turbo_confirm: "「#{@item.name}」を本当に削除しますか?" } }, class: "w-full card bg-white text-error px-6 py-4 border-2 border-error rounded-full flex items-center justify-center font-bold", data: { controller: "button", action: "touchstart->button#press touchend->button#release touchcancel->button#release" } do %>
        <span class="text-xl tracking-widest">この商品を削除する</span>
      <% end %>
    </div>
  </div>
<% end %>
